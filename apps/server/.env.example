# Copy to .env to override the development defaults. All three are optional
# in development; DATABASE_URL and JWT_SECRET are required when NODE_ENV=production.

# PORT=2567

# Defaults to the database started by `docker compose up -d`
# DATABASE_URL=mysql://root:flowing_fist@localhost:3307/flowing_fist

# Signs the tokens that identify players. Use a long random value in production.
# JWT_SECRET=
