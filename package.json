{
  "name": "flowing-fist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @flowing-fist/client dev",
    "build": "pnpm --filter @flowing-fist/client build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "assets": "pnpm --filter @flowing-fist/assets build",
    "test:e2e": "pnpm --filter @flowing-fist/client test:e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@11.2.2"
}
